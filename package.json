    "eval:intent-grounded-playability": "tsx scripts/eval-intent-grounded-playability.ts",
    "eval:intent-grounded-playability:live": "VERSECRAFT_ENABLE_INTENT_GROUNDED_PLAYABILITY_EVALS=1 tsx scripts/eval-intent-grounded-playability.ts --mode live --assert-strict --json-out .runtime-data/eval/intent-grounded-playability-live/report.json --markdown-out .runtime-data/eval/intent-grounded-playability-live/report.md",

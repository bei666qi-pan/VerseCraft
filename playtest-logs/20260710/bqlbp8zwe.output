  const blockers = factors.blockers;
  const routeOk = factors.routeHintCodes.length >= 2;
  const conditionsKnown = (prev.knownConditions ?? []).length >= 4;
  const reqAllMet =
    met.has("obtain_b2_access") &&
    met.has("secure_key_item") &&


# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cursor debug NDJSON (local ingest)
.cursor/debug-*.log

# local agent scratch / backups
# Keep Claude Code's local state out of Git, but version the project-level
# OpenSpec commands and skills so a clone gets the same workflow adapters.
.claude/*
!.claude/commands/
!.claude/commands/opsx/
!.claude/commands/opsx/*.md
!.claude/skills/
!.claude/skills/openspec-*/
!.claude/skills/openspec-*/SKILL.md
.codex-backup/

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/screenshots/
/videos/
*.webm

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# playtest / local logs (runtime artifacts)
/logs/
/playtest-logs/

# env files (keep templates)
.env
.env.*
!.env.example
!.env.template
!.env*.example
!.env*.template
!.env.local.oneapi.example

# runtime data
/.runtime-data/
/.local-runtime/
/.ops/autoops/runtime/*
!/.ops/autoops/runtime/.gitkeep
/tmp/
/temp/
/traces/

# editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# local docker volumes / data dirs (defense-in-depth)
pgdata/
postgres_data/
redisdata/
redis_data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.tsconfig.ai-playtest-*.json
dump.rdb

# 本地部署凭证,严禁入库
部署凭证.txt

# pnpm 本地 store（沙盒安装产物）
/.pnpm-store

# AI 编辑器配置（开发机本地，不入库）
/.codex/
/.kimi/

# benchmark runtime artifacts（一次性评测产物，自动重生）
/benchmarks/chat-benchmark-*.json
/benchmarks/combat-*.json
/benchmarks/director-live-*.json

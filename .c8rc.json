{
  "include": ["src/**/*.{ts,tsx}"],
  "exclude": [
    "src/**/*.test.{ts,tsx}",
    "src/**/*.spec.{ts,tsx}",
    "src/**/__tests__/**",
    "node_modules/**"
  ],
  "reporter": ["text", "json", "html"],
  "all": true,
  "src": ["src"],
  "tempDirectory": ".runtime-data/coverage/tmp",
  "reportDir": ".runtime-data/coverage",
  "skipFull": false,
  "checkCoverage": false,
  "lines": 50,
  "functions": 50,
  "branches": 50,
  "statements": 50
}
